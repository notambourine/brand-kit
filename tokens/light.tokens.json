{
  "light": {
    "$description": "Light theme, opt-in: add class=\"theme-light\" to a root or any subtree (print, a press page, an email). Values only, so the vars.css-alone path carries both themes; a surface with its own base layer sets background: var(--bg) itself.",
    "$type": "color",
    "bg": { "$value": "{light-neutrals.nt-paper}" },
    "bg-card": { "$value": "{light-neutrals.nt-white}" },
    "bg-raised": { "$value": "{light-neutrals.nt-white}" },
    "bg-input": { "$value": "{light-neutrals.nt-white}" },
    "bg-inverse": { "$value": "{dark-surfaces.nt-bg}" },
    "fg1": { "$value": "{brand.nt-ink}" },
    "fg2": { "$value": "{brand.nt-ink-70}" },
    "fg3": { "$value": "{light-neutrals.nt-mid}" },
    "fg-mute": { "$value": "{light-neutrals.nt-mid}" },
    "line": { "$value": "{light-neutrals.nt-line}" },
    "line-soft": { "$value": "{light-neutrals.nt-line-soft}" },
    "line-strong": { "$value": "{brand.nt-ink}" },
    "accent-text": { "$value": "{brand.nt-pink-deep}" },
    "accent-fg": { "$value": "{brand.nt-pink-deep}" },
    "support-fg": { "$value": "{brand.nt-mint-deep}" },
    "accent-soft": { "$value": "{brand.nt-pink-soft}" },
    "support-soft": { "$value": "{brand.nt-mint-soft}" },
    "bg-veil": { "$value": "rgba(250,248,249,0.70)" },
    "shadow-1": {
      "$value": "0 1px 2px rgba(26,21,23,0.08), 0 1px 1px rgba(26,21,23,0.05)",
      "$type": "shadow",
      "$description": "Alphas tuned for paper; the dark set reads as smudges here. The rose-black tint keeps the neutrals' hue bias."
    },
    "shadow-2": {
      "$value": "0 6px 18px rgba(26,21,23,0.10), 0 2px 6px rgba(26,21,23,0.07)",
      "$type": "shadow"
    },
    "shadow-3": {
      "$value": "0 20px 50px rgba(26,21,23,0.16), 0 6px 14px rgba(26,21,23,0.08)",
      "$type": "shadow"
    }
  }
}
